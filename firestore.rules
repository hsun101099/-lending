rules_version = '2';

// 放款流程管理系統 Firestore 安全性規則
//
// 設定方式：Firebase Console → Firestore Database → 規則 → 貼上以下內容 → 發布
//
// 原則：
// 1. 網址是公開的，任何人都可以在 Authentication 建立帳號，這一層擋不住。
// 2. 因此真正的門檻放在這裡：只有輸入過正確「單位註冊碼」、
//    在 members 名冊裡有紀錄的人，才讀得到任何一筆案件資料。
// 3. 註冊碼存在 config/registration，外人讀不到，只有規則本身比對得到。

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 已通過註冊碼驗證、正式加入單位的人
    function isMember() {
      return isSignedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function registrationCode() {
      return get(/databases/$(database)/documents/config/registration).data.code;
    }

    // 註冊碼必須真的是一組有內容的字串。
    // 萬一 code 欄位被誤刪或清空，這裡會讓所有人都加不進名冊（寧可鎖住也不放行），
    // 而不是變成「送出空值就能通過比對」。
    function codeIsSet() {
      return exists(/databases/$(database)/documents/config/registration)
             && registrationCode() is string
             && registrationCode().size() >= 4;
    }

    // 成員名冊：只能把自己加進來，而且必須附上正確的註冊碼
    match /members/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && codeIsSet()
                    && request.resource.data.code == registrationCode();
      allow update: if isSignedIn()
                    && request.auth.uid == uid
                    && codeIsSet()
                    && request.resource.data.code == registrationCode();
      // 只能把自己移出名冊（要再進來一樣得輸入註冊碼）
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // 單位設定（註冊碼）：外人讀不到；尚未設定時由第一位使用者設定
    match /config/{docId} {
      allow read: if isMember();
      allow create: if isSignedIn() && docId == 'registration' && !codeIsSet();
      allow update: if isMember();
      allow delete: if false;
    }

    // 案件資料：只有名冊裡的同仁看得到、改得動
    match /cases/{caseId} {
      allow read, write: if isMember();
    }

    // 案件編號計數器：由系統交易配發
    match /counters/{counterId} {
      allow read, write: if isMember();
    }

    // 其他路徑一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
